{
  "name": "@zooid/budd",
  "version": "0.0.3",
  "description": "budd — dockerized daemon for running CLI coding agents (Claude Code, Codex, ...) behind a simple API.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "budd": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "release-it"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@zooid/budd-adapter-claude": "workspace:*",
    "@zooid/budd-adapter-codex": "workspace:*",
    "@zooid/budd-core": "workspace:*",
    "@zooid/budd-runtime-docker": "workspace:*",
    "@zooid/budd-runtime-local": "workspace:*",
    "@zooid/budd-transport-http": "workspace:*",
    "hono": "^4.6.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "release-it": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^3.2.0"
  }
}
