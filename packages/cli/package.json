{
  "name": "zooid",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "zooid": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "tsup && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@zooid/sdk": "workspace:*",
    "@zooid/types": "workspace:*",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.34",
    "execa": "^9.5.3",
    "tsup": "^8.5.1",
    "vitest": "^3.2.0"
  }
}
