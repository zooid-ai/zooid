{
  "name": "zooid",
  "version": "0.7.4",
  "description": "Open-source tool for defining and running AI agents alongside you and your team. Any model, any CLI.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "zooid": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "zooid": {
    "zoonWebVersion": "0.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "release-it"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@inquirer/prompts": "^8.4.3",
    "@zooid/acp-client": "workspace:^",
    "@zooid/context-mcp": "workspace:^",
    "@zooid/core": "workspace:^",
    "@zooid/runtime-docker": "workspace:^",
    "@zooid/runtime-local": "workspace:^",
    "@zooid/transport-http": "workspace:^",
    "@zooid/transport-matrix": "workspace:^",
    "cac": "^6.7.14",
    "chalk": "^5.4.1",
    "hono": "^4.6.0",
    "listr2": "^8.2.5",
    "marked": "^18.0.4",
    "sanitize-html": "^2.17.4",
    "tar": "^7.5.16",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^0.21.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "release-it": "^19.2.4",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.0"
  }
}
