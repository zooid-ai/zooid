{
  "name": "@zooid/agentd",
  "version": "0.0.1",
  "description": "agentd — dockerized daemon for running CLI coding agents (Claude Code, Codex, ...) behind a simple API.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "agentd": "./dist/bin.js"
  },
  "files": ["dist", "src", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@zooid/agentd-adapter-claude": "workspace:*",
    "@zooid/agentd-core": "workspace:*",
    "@zooid/agentd-runtime-docker": "workspace:*",
    "@zooid/agentd-runtime-local": "workspace:*",
    "@zooid/agentd-transport-http": "workspace:*",
    "hono": "^4.6.0",
    "ulidx": "^2.3.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^3.2.0"
  }
}
