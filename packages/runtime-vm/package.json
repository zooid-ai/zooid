{
  "name": "@zooid/runtime-vm",
  "version": "0.17.1",
  "description": "smolvm runtime for zooid. Runs the agent's ACP process in a per-agent microVM booted from an OCI image.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:vm": "node ../../scripts/test-tier.mjs --no-file-parallelism src/vm-acp.integration.test.ts"
  },
  "dependencies": {
    "@zooid/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.0"
  }
}
