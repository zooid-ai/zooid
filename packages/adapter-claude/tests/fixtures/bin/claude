#!/bin/sh
# Stub claude binary for agentd tests.
# Honors env vars:
#   STUB_EXIT_CODE   — exit with this code (default 0)
#   STUB_STDERR      — write this to stderr before exit
#   STUB_DELAY_MS    — sleep this many milliseconds before emitting output
#   STUB_ARGV_FILE   — write one argv element per line to this file

if [ -n "$STUB_ARGV_FILE" ]; then
  : > "$STUB_ARGV_FILE"
  for a in "$@"; do
    printf '%s\n' "$a" >> "$STUB_ARGV_FILE"
  done
fi

if [ -n "$STUB_DELAY_MS" ]; then
  sleep_seconds=$(awk "BEGIN { printf \"%f\", $STUB_DELAY_MS / 1000 }" < /dev/null)
  sleep "$sleep_seconds"
fi

if [ -n "$STUB_STDERR" ]; then
  printf '%s\n' "$STUB_STDERR" >&2
fi

printf '{"type":"assistant","content":"Reading src/login.ts..."}\n'
printf '{"type":"assistant","content":"Fixed the null check."}\n'

exit "${STUB_EXIT_CODE:-0}"
