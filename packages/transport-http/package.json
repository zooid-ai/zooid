{
  "name": "@zooid/agentd-transport-http",
  "version": "0.0.1",
  "description": "HTTP transport for agentd. POST /run accepts an HMAC-signed prompt and streams SessionEvents back as SSE.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["dist", "src", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zooid/agentd-core": "workspace:*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@zooid/agentd-adapter-claude": "workspace:*",
    "@zooid/agentd-runtime-local": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^3.2.0"
  }
}
