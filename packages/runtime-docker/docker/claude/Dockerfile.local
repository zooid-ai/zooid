# budd/claude-code:local — local-source build for end-to-end testing.
#
# Same shape as ./Dockerfile (the published base image), except budd is
# built from the working tree via `pnpm deploy` instead of installed from
# npm. Use this to validate a release before publishing.
#
# Build context MUST be the budd repo root, not this directory:
#
#   docker build \
#     -f packages/runtime-docker/docker/claude/Dockerfile.local \
#     -t budd/claude-code:local \
#     .
#
# Run with your workspace mounted and a real Anthropic key:
#
#   docker run --rm -p 8080:8080 \
#     -e BUDD_TOKEN=$(openssl rand -hex 32) \
#     -e ANTHROPIC_API_KEY=sk-... \
#     -v "$PWD:/workspace" \
#     budd/claude-code:local

# ─── Stage 1: build budd from local source ────────────────────────────────
FROM node:22-slim AS builder

RUN corepack enable && corepack prepare pnpm@10.7.0 --activate

WORKDIR /src

# Copy lockfile + workspace manifests first so `pnpm install` is cacheable
# even when only source changes.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/core/package.json              packages/core/
COPY packages/adapter-claude/package.json    packages/adapter-claude/
COPY packages/adapter-codex/package.json     packages/adapter-codex/
COPY packages/runtime-local/package.json     packages/runtime-local/
COPY packages/runtime-docker/package.json    packages/runtime-docker/
COPY packages/transport-http/package.json    packages/transport-http/
COPY packages/cli/package.json               packages/cli/

RUN pnpm install --frozen-lockfile

# Now copy sources and build.
COPY packages/core              packages/core
COPY packages/adapter-claude    packages/adapter-claude
COPY packages/adapter-codex     packages/adapter-codex
COPY packages/runtime-local     packages/runtime-local
COPY packages/runtime-docker    packages/runtime-docker
COPY packages/transport-http    packages/transport-http
COPY packages/cli               packages/cli

RUN pnpm -r build

# Produce a self-contained, prod-only deploy of the cli at /out — workspace
# deps get materialised under /out/node_modules with their built dist/.
RUN pnpm --filter=@zooid/budd deploy --prod --legacy /out

# ─── Stage 2: runtime image ─────────────────────────────────────────────────
FROM node:22-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG CLAUDE_CODE_VERSION=latest
RUN npm i -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"

COPY --from=builder /out /opt/budd

WORKDIR /workspace

EXPOSE 8080
# budd and claude live in the same container — the embedded daemon must
# spawn on the host (this container), not in another docker container.
# `--runtime local` is baked into ENTRYPOINT (not CMD) so it survives any
# extra flags the user appends to `docker run`.
ENTRYPOINT ["node", "/opt/budd/dist/bin.js", "--runtime", "local"]

LABEL org.budd.base="claude-code" \
      org.budd.agent="base" \
      org.budd.description="budd + Claude Code CLI (local-source build)"
