{
  "name": "zooid-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "zooid monorepo — daemon for running coding agents behind Matrix and HTTP transports.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist",
    "tuwunel:logs": "docker logs -f --tail 200 zooid-tuwunel",
    "tuwunel:errors": "docker logs zooid-tuwunel 2>&1 | grep -E 'ERROR|WARN' | tail -40",
    "tuwunel:as": "docker logs zooid-tuwunel 2>&1 | grep -i appservice | tail -40",
    "tuwunel:shell": "docker exec -it zooid-tuwunel /bin/sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^3.2.0"
  }
}
