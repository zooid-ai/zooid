# Vertex Express (API key) auth — opencode reads this via @ai-sdk/google-vertex.
# Copy to .env and replace with your real key. Express keys carry their own
# project/location, so GOOGLE_CLOUD_PROJECT / VERTEX_LOCATION are not needed.
GOOGLE_VERTEX_API_KEY="AQ.YOUR_KEY_HERE"

# Optional, for traceability — not consumed by the AI SDK in Express mode.
GCP_PROJECT_ID="your-project"
